# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env 模板要进仓库
!.env.example

# Next 16 运行 next dev 时自动生成的代理说明文件，不属于项目内容
AGENTS.md

# 生成物：法规库由 npm run corpus 重建
/data/build/

# 只在本机测试用的真实材料（队友收集的合同照片），不能公开
/_private/
/eval/photos/

# 测试输出
/test-results/
/playwright-report/

# 法规原始网页缓存，可用 npm run corpus:fetch 重新下载
/data/raw/

# 向量模型文件，用 npm run corpus:model 下载，哈希在 data/model-lock.json
/models/

# 用量记录数据库（运行时生成）
/data/runtime/

# 浏览器端识别用的文件，由 scripts/copy-vendor.mjs 从 node_modules 拷来
/public/vendor/

# 部署打包产物（deploy/pack.sh 生成）
/deploy/build/
