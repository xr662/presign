# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env 模板要进仓库
!.env.example

# 生成物：法规库由 npm run corpus 重建
/data/build/

# 只在本机测试用的材料，不能公开。eval/photos/ 的照片是队友拍的示例合同，打印页脚印着
# 打印用电脑的文件路径（含微信号），照片不进仓库；识别出的文字在 eval/photos/ocr/，路径已略去
/_private/
/eval/photos/*.jpg

# 测试输出
/test-results/
/playwright-report/

# 法规原始网页缓存，可用 npm run corpus:fetch 重新下载
/data/raw/

# 向量模型文件，用 npm run corpus:model 下载，哈希在 data/model-lock.json
/models/

# 用量记录数据库（运行时生成）
/data/runtime/

# 浏览器端识别用的文件，由 scripts/copy-vendor.mjs 从 node_modules 拷来
/public/vendor/

# 部署打包产物（deploy/pack.sh 生成）
/deploy/build/

# 技术文档草稿（node scripts/doc-pdf.mjs --draft），定稿 PDF 才提交
/docs/*-草稿.pdf

