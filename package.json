{
  "name": "presign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "lint:copy": "node scripts/copy-lint.mjs",
    "scan": "node scripts/scan-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run lint:copy && npm run scan && npm run build",
    "contrast": "node scripts/contrast.mjs",
    "shots": "node scripts/screenshot.mjs",
    "measure:js": "node scripts/measure-js.mjs",
    "corpus:fetch": "node scripts/corpus/fetch.ts",
    "corpus:parse": "node scripts/corpus/parse.ts",
    "corpus:check": "node scripts/corpus/crosscheck.ts",
    "corpus:model": "node scripts/corpus/fetch-model.ts",
    "corpus:build": "node scripts/corpus/build-db.ts",
    "corpus": "npm run corpus:fetch && npm run corpus:parse && npm run corpus:check && npm run corpus:wage && npm run corpus:model && npm run corpus:build",
    "bench:embed": "node --liftoff-only scripts/corpus/bench-embed.ts",
    "corpus:wage": "node scripts/corpus/min-wage.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "onnxruntime-web": "^1.31.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "签前：毕业生签约前的合同检查和谈判练习",
  "engines": {
    "node": ">=24"
  }
}
