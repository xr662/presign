# 复制为 .env.local 后填值。.env* 都不进仓库，只有这个模板会提交。

# ── 模型（OpenAI 兼容接口）──────────────────────────────
# 主模型：计划、执行、报告、看图识别、检索重排。模型名区分大小写，小写的 deepseek-v4-flash 会报 model name not found
LLM_MAIN_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
LLM_MAIN_API_KEY=
LLM_MAIN_MODEL=Deepseek-v4-flash

# 复核模型：自检、HR 角色，也是主模型请求挂住时对冲请求的去处。同一个模型也行；单独留变量，以后换模型不用改代码
LLM_ALT_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
LLM_ALT_API_KEY=
LLM_ALT_MODEL=Deepseek-v4-flash

# 思考模式默认都不开：实测自检开 high 80 秒没返回、报告开 medium 3 条批注 48 秒，一次检查超出 120 秒上限。
# 要单独打开哪一步就填哪一步：low / medium / high（off 为关）
REASONING_VERIFY=
REASONING_REPORT=
REASONING_EXTRACT=

# 备用：前两个都失败时用。11 月中旬换 DeepSeek 官方付费 key 时填这里（https://api.deepseek.com/v1）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── 用量控制 ────────────────────────────────────────────
# 全站每天最多消耗的 token 数，超出后评审账号改看示例结果
DAILY_TOKEN_BUDGET=3000000
# 平台请求次数限额是 5 小时 1200、7 天 9000、30 天 18000，这里留余量
PLATFORM_REQUESTS_5H=1100
PLATFORM_REQUESTS_7D=8500
PLATFORM_REQUESTS_30D=17000
# 用量记录（只有次数、token 和耗时，没有合同内容）
USAGE_DB_PATH=data/runtime/usage.db
# 每个评审账号每天最多检查几份合同
DAILY_REVIEWS_PER_ACCOUNT=20

# ── 评审账号 ────────────────────────────────────────────
# 格式：用户名:scrypt$盐$哈希，多个用逗号分隔。用 npm run account:hash -- 用户名 生成（密码从键盘输入，不进命令行历史）
JUDGE_ACCOUNTS=
# 会话 Cookie 签名密钥，32 位以上随机字符串。本机开发不填时识别和检查不用登录；生产环境不填则一律要求登录且无法登录
SESSION_SECRET=

# ── MCP 服务 ────────────────────────────────────────────
# 法规工具服务只监听本机
MCP_URL=http://127.0.0.1:3101/mcp
